{
  "name": "gettogether",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "web": "node scripts/byg-web.mjs",
    "start": "npm run web && expo start",
    "tjek": "npx expo install --check && npx expo-doctor",
    "build:test": "npm run web && eas build --platform android --profile preview",
    "build:android": "npm run web && eas build --platform android --profile production",
    "build:ios": "npm run web && eas build --platform ios --profile production",
    "send:android": "eas submit --platform android --latest",
    "send:ios": "eas submit --platform ios --latest",
    "opdater": "npm run web && eas update --branch production --message \"Ny version af guiden og fællesskabet\"",
    "eas-build-post-install": "node scripts/byg-web.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  }
}
